# Optional Appwrite application backend. The local demo works without these values.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_ALERTS_COLLECTION_ID=
APPWRITE_API_KEY=

# Next.js dashboard. Leave blank to derive the backend origin from the current
# dashboard host; set an explicit URL for a separate backend host.
NEXT_PUBLIC_API_BASE_URL=
# Set this to the detector read/control token when API authentication is enabled.
# Do not use a browser-exposed token for multi-user production deployments.
NEXT_PUBLIC_DETECTOR_API_TOKEN=
AUTH_SECRET=replace-with-a-long-random-value
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local LLM explanation layer (Ollama). For Docker Compose, use the
# service name below. For a host-installed Ollama, use http://127.0.0.1:11434.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=45

# Optional FastAPI authorization. DETECTOR_CONTROL_TOKEN can start/stop replay
# and live capture; DETECTOR_READ_TOKEN is sufficient for dashboard reads.
DETECTOR_READ_TOKEN=
DETECTOR_CONTROL_TOKEN=
